# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Read by `wrangler dev` for local runs, and by `npm run register`.
# In production these live as Cloudflare secrets instead - see the README.

# Discord developer portal -> your application -> General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Discord developer portal -> your application -> Bot -> Reset Token.
# Shown once. Treat it like a password; anyone holding it controls the bot.
DISCORD_BOT_TOKEN=

# Optional, but use it while developing: commands registered to one guild
# appear instantly, where global ones take up to an hour to propagate.
# Discord -> User Settings -> Advanced -> Developer Mode, then right-click
# the server icon -> Copy Server ID.
DISCORD_TEST_GUILD_ID=
