{
  "name": "mooji",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Persona-style turn-based RPG Discord bot running on Cloudflare Workers.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run wiki && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "register": "tsx scripts/register-commands.ts",
    "db:local": "wrangler d1 execute mooji --local --file=./migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute mooji --remote --file=./migrations/0001_init.sql",
    "wiki": "tsx wiki/build.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
